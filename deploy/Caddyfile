harotiholdingslimited.com, www.harotiholdingslimited.com {
	encode gzip

	# Bare /erp must redirect — otherwise it falls through to the marketing site
	@erpBare path /erp
	redir @erpBare /erp/ 308

	# ERP API (proxied through the ERP nginx container)
	handle /api/* {
		reverse_proxy 127.0.0.1:9081
	}

	# ERP web app (staff login, customer portal, operations UI)
	handle_path /erp/* {
		reverse_proxy 127.0.0.1:9081
	}

	# Public marketing website
	handle {
		reverse_proxy 127.0.0.1:9080
	}
}

# Mailcow admin UI + webmail (Mailcow handles SMTP/IMAP ports directly)
mail.harotiholdingslimited.com {
	encode gzip
	reverse_proxy https://127.0.0.1:8443 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Outlook / Thunderbird autodiscover (DNS CNAME → mail)
autodiscover.harotiholdingslimited.com, autoconfig.harotiholdingslimited.com {
	encode gzip
	reverse_proxy https://127.0.0.1:8443 {
		header_up Host mail.harotiholdingslimited.com
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			tls_insecure_skip_verify
		}
	}
}
